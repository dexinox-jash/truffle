{
  "manifest_version": 3,
  "name": "Ruflo AI Meeting Notes",
  "version": "1.0.0",
  "description": "Record and transcribe meetings from Zoom, Teams, and Meet",
  "permissions": [
    "activeTab",
    "tabCapture",
    "storage",
    "notifications",
    "identity"
  ],
  "host_permissions": [
    "https://*.zoom.us/*",
    "https://teams.microsoft.com/*",
    "https://meet.google.com/*",
    "https://api.ruflo.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.zoom.us/*",
        "https://teams.microsoft.com/*",
        "https://meet.google.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
