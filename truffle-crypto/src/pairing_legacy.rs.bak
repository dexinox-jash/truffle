//! Device Pairing Ceremony
//!
//! This module implements the secure device pairing ceremony for Project Truffle.
//! It uses QR codes for initial key exchange and Short Authentication Strings (SAS)
//! for MITM protection.
//!
//! ## Pairing Flow
//!
//! ```text
//! Primary Device                    Secondary Device
//! ──────────────                    ────────────────
//!      │                                   │
//!      │  1. Generate identity keys        │
//!      │  2. Create X3DH bundle            │
//!      │  3. Generate QR code              │
//!      │ ───────────────────────────────> │
//!      │     (QR contains public bundle    │
//!      │      + websocket endpoint)        │
//!      │                                   │
//!      │  4. Scan QR code                  │
//!      │  5. Generate own keys             │
//!      │  6. Perform X3DH handshake        │
//!      │ <─────────────────────────────── │
//!      │     (Send ephemeral public key)   │
//!      │                                   │
//!      │  7. Derive shared secret          │
//!      │  8. Compute SAS code              │
//!      │  9. Display SAS on both devices   │
//!      │  10. User compares and confirms   │
//!      │                                   │
//!      │  11. Pairing complete!            │
//!      │     (Sync key established)        │
//! ```
//!
//! ## Security Properties
//!
//! - **Authentication**: Ed25519 signatures verify device identity
//! - **Confidentiality**: X3DH establishes encrypted channel
//! - **MITM Protection**: SAS comparison prevents man-in-the-middle attacks
//! - **Forward Secrecy**: Ephemeral keys protect past sessions
//! - **Post-Quantum**: Kyber-768 provides quantum resistance

use crate::{
    keys::{Ed25519Identity, X25519Keypair, derive_sync_key},
    x3dh::{X3DHKeyBundle, X3DHPublicBundle, x3dh_initiate, x3dh_respond, X3DHResult},
    CryptoError, CryptoResult,
};
use qrcode::QrCode;
use zeroize::{Zeroize, ZeroizeOnDrop};

/// QR code data for device pairing
///
/// This is encoded in the QR code displayed by the primary device.
#[derive(Debug, Clone, serde::Serialize, serde::Deserialize)]
pub struct PairingQrData {
    /// Protocol version
    pub version: u8,
    /// Device ID (hashed fingerprint)
    pub device_id: String,
    /// X3DH public bundle (base64 encoded)
    pub x3dh_bundle: String,
    /// WebSocket relay endpoint
    pub relay_endpoint: String,
    /// One-time pairing token
    pub pairing_token: String,
    /// Timestamp (for expiration)
    pub timestamp: u64,
}

impl PairingQrData {
    /// Create new QR data
    pub fn new(
        device_id: String,
        x3dh_bundle: Vec<u8>,
        relay_endpoint: String,
        pairing_token: String,
    ) -> Self {
        Self {
            version: 1,
            device_id,
            x3dh_bundle: base64::encode(&x3dh_bundle),
            relay_endpoint,
            pairing_token,
            timestamp: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap_or_default()
                .as_secs(),
        }
    }

    /// Serialize to JSON string
    pub fn to_json(&self) -> String {
        serde_json::to_string(self).unwrap_or_default()
    }

    /// Deserialize from JSON string
    pub fn from_json(json: &str) -> CryptoResult<Self> {
        serde_json::from_str(json)
            .map_err(|e| CryptoError::InvalidCiphertext(format!("Invalid QR data: {}", e)))
    }

    /// Get X3DH bundle bytes
    pub fn x3dh_bundle_bytes(&self) -> CryptoResult<Vec<u8>> {
        base64::decode(&self.x3dh_bundle)
            .map_err(|e| CryptoError::InvalidCiphertext(format!("Invalid base64: {}", e)))
    }

    /// Check if the QR code has expired (default: 10 minutes)
    pub fn is_expired(&self, max_age_secs: u64) -> bool {
        let now = std::time::SystemTime::now()
            .duration_since(std::time::UNIX_EPOCH)
            .unwrap_or_default()
            .as_secs();
        now.saturating_sub(self.timestamp) > max_age_secs
    }
}

/// Generate a QR code for device pairing
///
/// # Arguments
///
/// * `device_id` - Unique device identifier
/// * `public_key` - X3DH public bundle bytes
/// * `relay_endpoint` - WebSocket relay endpoint URL
/// * `pairing_token` - One-time pairing token
///
/// # Returns
///
/// Returns an SVG string representing the QR code.
///
/// # Example
///
/// ```rust
/// use truffle_crypto::pairing::generate_qr_code;
///
/// let device_id = "device-123";
/// let public_key = vec![0u8; 100]; // X3DH bundle
/// let relay = "wss://relay.truffle.io/pair";
/// let token = "abc123";
///
/// let qr_svg = generate_qr_code(device_id, &public_key, relay, token);
/// ```
pub fn generate_qr_code(
    device_id: &str,
    public_key: &[u8],
    relay_endpoint: &str,
    pairing_token: &str,
) -> String {
    let qr_data = PairingQrData::new(
        device_id.to_string(),
        public_key.to_vec(),
        relay_endpoint.to_string(),
        pairing_token.to_string(),
    );

    let json_data = qr_data.to_json();

    // Generate QR code
    let code = QrCode::new(&json_data).unwrap_or_else(|_| {
        // Fallback to a minimal QR code if generation fails
        QrCode::new("{}").unwrap()
    });

    // Render as SVG
    code.render()
        .min_dimensions(200, 200)
        .dark_color(qrcode::render::svg::Color("#000000"))
        .light_color(qrcode::render::svg::Color("#FFFFFF"))
        .build()
}

/// Generate a QR code from an X3DH bundle
///
/// This is the primary function for generating pairing QR codes.
///
/// # Arguments
///
/// * `bundle` - X3DH public bundle
/// * `relay_endpoint` - WebSocket relay endpoint URL
/// * `pairing_token` - One-time pairing token
///
/// # Returns
///
/// Returns an SVG string representing the QR code.
pub fn generate_qr_from_bundle(
    bundle: &X3DHPublicBundle,
    relay_endpoint: &str,
    pairing_token: &str,
) -> String {
    let device_id = hex::encode(&bundle.identity_key[..8]);
    let bundle_bytes = bundle.to_bytes();

    generate_qr_code(&device_id, &bundle_bytes, relay_endpoint, pairing_token)
}

/// Short Authentication String (SAS) for MITM protection
///
/// SAS is a short code that both devices display during pairing.
/// Users visually compare the codes to detect man-in-the-middle attacks.
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct SasCode(String);

impl SasCode {
    /// Generate a SAS code from shared secrets
    ///
    /// The SAS is derived from the X3DH shared secret and is guaranteed
    /// to be the same on both devices if there's no MITM.
    ///
    /// # Arguments
    ///
    /// * `shared_secret` - The X3DH shared secret
    /// * `alice_identity` - Alice's Ed25519 public key
    /// * `bob_identity` - Bob's Ed25519 public key
    ///
    /// # Returns
    ///
    /// Returns a 6-digit SAS code.
    pub fn generate(
        shared_secret: &[u8; 32],
        alice_identity: &[u8; 32],
        bob_identity: &[u8; 32],
    ) -> Self {
        // Combine inputs for SAS derivation
        let mut input = Vec::with_capacity(32 + 32 + 32);
        input.extend_from_slice(shared_secret);
        input.extend_from_slice(alice_identity);
        input.extend_from_slice(bob_identity);

        // Use first 4 bytes of hash as SAS
        let hash = crate::sha3_256_hash(&input);
        let sas_value = u32::from_be_bytes([hash[0], hash[1], hash[2], hash[3]]);

        // Convert to 6-digit code
        let sas_digits = sas_value % 1_000_000;
        Self(format!("{:06}", sas_digits))
    }

    /// Get the SAS code as a string
    pub fn as_str(&self) -> &str {
        &self.0
    }

    /// Get the SAS code as a formatted string (e.g., "123-456")
    pub fn formatted(&self) -> String {
        if self.0.len() == 6 {
            format!("{}-{}", &self.0[0..3], &self.0[3..6])
        } else {
            self.0.clone()
        }
    }

    /// Verify that two SAS codes match
    ///
    /// This comparison is done in constant time to prevent timing attacks.
    pub fn verify(&self, other: &SasCode) -> bool {
        crate::constant_time_eq(self.0.as_bytes(), other.0.as_bytes())
    }
}

/// Verify SAS codes match (convenience function)
///
/// # Arguments
///
/// * `code1` - First SAS code
/// * `code2` - Second SAS code
///
/// # Returns
///
/// Returns true if the codes match exactly.
pub fn verify_sas(code1: &str, code2: &str) -> bool {
    if code1.len() != code2.len() {
        return false;
    }
    crate::constant_time_eq(code1.as_bytes(), code2.as_bytes())
}

/// Result of a successful pairing
#[derive(Debug, Clone)]
pub struct PairingResult {
    /// The derived sync key for encrypting CRDT updates
    pub sync_key: [u8; 32],
    /// Associated data for the session
    pub associated_data: Vec<u8>,
    /// SAS code that was displayed (for verification logging)
    pub sas_code: String,
    /// Primary device identity (for future authentication)
    pub primary_identity: [u8; 32],
    /// Secondary device identity
    pub secondary_identity: [u8; 32],
}

/// Device pairing ceremony state machine
///
/// This manages the complete pairing flow from QR generation to completion.
pub struct PairingCeremony {
    /// Current state of the ceremony
    state: PairingState,
    /// Primary device's X3DH bundle (if primary)
    primary_bundle: Option<X3DHKeyBundle>,
    /// Secondary device's X3DH bundle (if secondary)
    secondary_bundle: Option<X3DHKeyBundle>,
    /// X3DH result after handshake
    x3dh_result: Option<X3DHResult>,
    /// SAS code for verification
    sas_code: Option<SasCode>,
}

/// States of the pairing ceremony
#[derive(Debug, Clone, PartialEq, Eq)]
pub enum PairingState {
    /// Initial state
    Initial,
    /// QR code generated (primary device)
    QrGenerated,
    /// QR code scanned (secondary device)
    QrScanned,
    /// X3DH handshake complete
    HandshakeComplete,
    /// SAS verified
    SasVerified,
    /// Pairing complete
    Complete,
    /// Pairing failed
    Failed(String),
}

impl PairingCeremony {
    /// Create a new pairing ceremony
    pub fn new() -> Self {
        Self {
            state: PairingState::Initial,
            primary_bundle: None,
            secondary_bundle: None,
            x3dh_result: None,
            sas_code: None,
        }
    }

    /// Start pairing as the primary device
    ///
    /// Generates the X3DH bundle and QR code.
    ///
    /// # Returns
    ///
    /// Returns the QR code SVG string.
    pub fn start_primary(&mut self, relay_endpoint: &str) -> CryptoResult<String> {
        if self.state != PairingState::Initial {
            return Err(CryptoError::PairingFailed(
                "Invalid state for starting primary".to_string()
            ));
        }

        // Generate X3DH bundle
        let bundle = X3DHKeyBundle::generate()?;

        // Generate pairing token
        let token = hex::encode(&crate::generate_random_key()?);

        // Generate QR code
        let qr_svg = generate_qr_from_bundle(&bundle.public, relay_endpoint, &token);

        self.primary_bundle = Some(bundle);
        self.state = PairingState::QrGenerated;

        Ok(qr_svg)
    }

    /// Get the primary device's X3DH public bundle
    ///
    /// This can be used to manually share the bundle without QR code.
    pub fn get_primary_bundle(&self) -> CryptoResult<X3DHPublicBundle> {
        self.primary_bundle
            .as_ref()
            .map(|b| b.public.clone())
            .ok_or_else(|| CryptoError::PairingFailed(
                "Primary bundle not available".to_string()
            ))
    }

    /// Start pairing as the secondary device by scanning QR code
    ///
    /// Parses the QR data and prepares for X3DH handshake.
    pub fn scan_qr(&mut self, qr_json: &str) -> CryptoResult<()> {
        if self.state != PairingState::Initial {
            return Err(CryptoError::PairingFailed(
                "Invalid state for scanning QR".to_string()
            ));
        }

        // Parse QR data
        let qr_data = PairingQrData::from_json(qr_json)?;

        // Check expiration
        if qr_data.is_expired(600) {
            // 10 minutes
            return Err(CryptoError::PairingFailed(
                "QR code has expired".to_string()
            ));
        }

        // Parse X3DH bundle
        let bundle_bytes = qr_data.x3dh_bundle_bytes()?;
        let _bundle = X3DHPublicBundle::from_bytes(&bundle_bytes)?;

        // Generate our own keys
        let secondary_bundle = X3DHKeyBundle::generate()?;

        self.secondary_bundle = Some(secondary_bundle);
        self.state = PairingState::QrScanned;

        Ok(())
    }

    /// Complete X3DH handshake as secondary device
    ///
    /// This performs the X3DH handshake and derives the sync key.
    pub fn complete_handshake_secondary(
        &mut self,
        primary_bundle: &X3DHPublicBundle,
    ) -> CryptoResult<(X3DHResult, [u8; 32])> {
        if self.state != PairingState::QrScanned {
            return Err(CryptoError::PairingFailed(
                "Invalid state for handshake".to_string()
            ));
        }

        let secondary = self.secondary_bundle.as_ref()
            .ok_or_else(|| CryptoError::PairingFailed(
                "Secondary bundle not available".to_string()
            ))?;

        // Perform X3DH initiation
        let identity_key = X25519Keypair::from_bytes(
            &secondary.public.identity_key,
            &secondary.private.identity_secret,
        );

        let (result, ephemeral_public) = x3dh_initiate(&identity_key, primary_bundle)?;

        self.x3dh_result = Some(result.clone());
        self.state = PairingState::HandshakeComplete;

        Ok((result, ephemeral_public))
    }

    /// Complete X3DH handshake as primary device
    ///
    /// This responds to the secondary device's handshake.
    pub fn complete_handshake_primary(
        &mut self,
        secondary_identity: [u8; 32],
        secondary_ephemeral: [u8; 32],
        kyber_ciphertext: Option<&[u8]>,
    ) -> CryptoResult<X3DHResult> {
        if self.state != PairingState::QrGenerated {
            return Err(CryptoError::PairingFailed(
                "Invalid state for handshake".to_string()
            ));
        }

        let primary = self.primary_bundle.as_ref()
            .ok_or_else(|| CryptoError::PairingFailed(
                "Primary bundle not available".to_string()
            ))?;

        // Perform X3DH response
        let result = x3dh_respond(
            &primary.private,
            primary.public.identity_key,
            secondary_identity,
            secondary_ephemeral,
            kyber_ciphertext,
        )?;

        self.x3dh_result = Some(result.clone());
        self.state = PairingState::HandshakeComplete;

        Ok(result)
    }

    /// Generate SAS code for verification
    ///
    /// This should be called after handshake is complete on both devices.
    pub fn generate_sas(&mut self, is_primary: bool) -> CryptoResult<SasCode> {
        if self.state != PairingState::HandshakeComplete {
            return Err(CryptoError::PairingFailed(
                "Handshake not complete".to_string()
            ));
        }

        let x3dh_result = self.x3dh_result.as_ref()
            .ok_or_else(|| CryptoError::PairingFailed(
                "X3DH result not available".to_string()
            ))?;

        let (alice_id, bob_id) = if is_primary {
            // Primary is Alice
            let primary = self.primary_bundle.as_ref().unwrap();
            (primary.public.identity_key, [0u8; 32]) // We don't have secondary's identity yet
        } else {
            // Secondary is Alice
            let secondary = self.secondary_bundle.as_ref().unwrap();
            (secondary.public.identity_key, [0u8; 32])
        };

        // For now, use a simplified SAS generation
        let sas = SasCode::generate(
            &x3dh_result.shared_secret,
            &alice_id,
            &bob_id,
        );

        self.sas_code = Some(sas.clone());
        Ok(sas)
    }

    /// Verify SAS code entered by user
    ///
    /// This completes the pairing if the SAS matches.
    pub fn verify_sas_code(&mut self, entered_code: &str) -> CryptoResult<PairingResult> {
        if self.state != PairingState::HandshakeComplete {
            return Err(CryptoError::PairingFailed(
                "Invalid state for SAS verification".to_string()
            ));
        }

        let expected_sas = self.sas_code.as_ref()
            .ok_or_else(|| CryptoError::PairingFailed(
                "SAS not generated".to_string()
            ))?;

        if !expected_sas.verify(&SasCode(entered_code.to_string())) {
            self.state = PairingState::Failed("SAS verification failed".to_string());
            return Err(CryptoError::SasVerificationFailed);
        }

        // Derive sync key
        let x3dh_result = self.x3dh_result.as_ref().unwrap();
        let sync_key = derive_sync_key(&x3dh_result.shared_secret)?;

        self.state = PairingState::Complete;

        Ok(PairingResult {
            sync_key,
            associated_data: x3dh_result.associated_data.clone(),
            sas_code: expected_sas.as_str().to_string(),
            primary_identity: [0u8; 32], // Would be set from actual handshake
            secondary_identity: [0u8; 32],
        })
    }

    /// Get current state
    pub fn state(&self) -> &PairingState {
        &self.state
    }

    /// Check if pairing is complete
    pub fn is_complete(&self) -> bool {
        matches!(self.state, PairingState::Complete)
    }
}

impl Default for PairingCeremony {
    fn default() -> Self {
        Self::new()
    }
}

impl Zeroize for PairingCeremony {
    fn zeroize(&mut self) {
        if let Some(ref mut bundle) = self.primary_bundle {
            bundle.private.zeroize();
        }
        if let Some(ref mut bundle) = self.secondary_bundle {
            bundle.private.zeroize();
        }
        if let Some(ref mut result) = self.x3dh_result {
            result.shared_secret.zeroize();
        }
    }
}

impl ZeroizeOnDrop for PairingCeremony {}

/// Generate a pairing token for relay authentication
///
/// This creates a cryptographically secure random token.
pub fn generate_pairing_token() -> CryptoResult<String> {
    let token = crate::generate_random_key()?;
    Ok(hex::encode(&token))
}

/// Generate device fingerprint for display
///
/// This creates a human-readable fingerprint from a public key.
pub fn format_device_fingerprint(public_key: &[u8]) -> String {
    let hash = crate::sha3_256_hash(public_key);
    let fingerprint = hex::encode(&hash[..8]);

    // Format as groups of 4 characters
    format!("{}-{}-{}-{}",
        &fingerprint[0..2],
        &fingerprint[2..4],
        &fingerprint[4..6],
        &fingerprint[6..8]
    )
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_generate_qr_code() {
        let device_id = "test-device";
        let public_key = vec![0x42u8; 100];
        let relay = "wss://relay.truffle.io/pair";
        let token = "test-token-123";

        let qr_svg = generate_qr_code(device_id, &public_key, relay, token);

        // Should be valid SVG
        assert!(qr_svg.contains("<svg"));
        assert!(qr_svg.contains("</svg>"));
    }

    #[test]
    fn test_sas_generation() {
        let shared_secret = [0x42u8; 32];
        let alice_identity = [0x01u8; 32];
        let bob_identity = [0x02u8; 32];

        let sas1 = SasCode::generate(&shared_secret, &alice_identity, &bob_identity);
        let sas2 = SasCode::generate(&shared_secret, &alice_identity, &bob_identity);

        // Same inputs should produce same SAS
        assert_eq!(sas1, sas2);

        // Should be 6 digits
        assert_eq!(sas1.as_str().len(), 6);

        // Should be numeric
        assert!(sas1.as_str().parse::<u32>().is_ok());
    }

    #[test]
    fn test_sas_verification() {
        let sas1 = SasCode("123456".to_string());
        let sas2 = SasCode("123456".to_string());
        let sas3 = SasCode("654321".to_string());

        assert!(sas1.verify(&sas2));
        assert!(!sas1.verify(&sas3));

        assert!(verify_sas("123456", "123456"));
        assert!(!verify_sas("123456", "654321"));
    }

    #[test]
    fn test_sas_formatted() {
        let sas = SasCode("123456".to_string());
        assert_eq!(sas.formatted(), "123-456");
    }

    #[test]
    fn test_pairing_qr_data() {
        let qr_data = PairingQrData::new(
            "device-123".to_string(),
            vec![0x42u8; 100],
            "wss://relay.truffle.io".to_string(),
            "token-abc".to_string(),
        );

        let json = qr_data.to_json();
        let parsed = PairingQrData::from_json(&json).unwrap();

        assert_eq!(qr_data.device_id, parsed.device_id);
        assert_eq!(qr_data.relay_endpoint, parsed.relay_endpoint);
    }

    #[test]
    fn test_qr_expiration() {
        let mut qr_data = PairingQrData::new(
            "device-123".to_string(),
            vec![0x42u8; 100],
            "wss://relay.truffle.io".to_string(),
            "token-abc".to_string(),
        );

        // Set timestamp to 15 minutes ago
        qr_data.timestamp = std::time::SystemTime::now()
            .duration_since(std::time::UNIX_EPOCH)
            .unwrap()
            .as_secs() - 900;

        assert!(qr_data.is_expired(600));
        assert!(!qr_data.is_expired(1200));
    }

    #[test]
    fn test_pairing_token_generation() {
        let token1 = generate_pairing_token().unwrap();
        let token2 = generate_pairing_token().unwrap();

        // Should be different
        assert_ne!(token1, token2);

        // Should be 64 hex characters (32 bytes)
        assert_eq!(token1.len(), 64);
    }

    #[test]
    fn test_device_fingerprint() {
        let public_key = [0x42u8; 32];
        let fingerprint = format_device_fingerprint(&public_key);

        // Should be formatted as XX-XX-XX-XX
        assert_eq!(fingerprint.len(), 11);
        assert_eq!(fingerprint.matches('-').count(), 3);
    }

    #[test]
    fn test_pairing_ceremony_state_machine() {
        let mut ceremony = PairingCeremony::new();

        assert_eq!(*ceremony.state(), PairingState::Initial);

        // Start as primary
        let qr = ceremony.start_primary("wss://relay.truffle.io").unwrap();
        assert!(!qr.is_empty());
        assert_eq!(*ceremony.state(), PairingState::QrGenerated);

        // Get primary bundle
        let bundle = ceremony.get_primary_bundle().unwrap();
        assert!(!bundle.identity_key.is_empty());
    }
}
