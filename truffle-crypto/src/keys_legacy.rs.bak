//! Key Generation, Derivation, and Management
//!
//! This module provides secure key management for Project Truffle:
//! - **Identity Keys**: Ed25519 for device authentication
//! - **Ephemeral Keys**: X25519 for forward secrecy
//! - **Symmetric Keys**: Derived via HKDF-SHA256 for encryption
//! - **Post-Quantum Keys**: Kyber-768 for quantum resistance
//!
//! ## Key Hierarchy
//!
//! ```text
//! Master Seed (256-bit, user-controlled or generated)
//!     │
//!     ├── HKDF-SHA256("identity")
//!     │   └── Ed25519 Identity Keypair (long-term device identity)
//!     │
//!     ├── HKDF-SHA256("x3dh-identity")
//!     │   └── X25519 Identity Keypair (for X3DH handshake)
//!     │
//!     ├── HKDF-SHA256("sync")
//!     │   └── Sync Key (AES-256, for CRDT encryption)
//!     │
//!     └── HKDF-SHA256("kyber")
//!         └── Kyber-768 Keypair (post-quantum hybrid)
//! ```
//!
//! ## Security Properties
//!
//! - **No Key Escrow**: All keys derived from user-controlled master seed
//! - **Forward Secrecy**: Ephemeral keys generated per session
//! - **Post-Quantum**: Kyber-768 provides quantum resistance
//! - **Secure Erasure**: All keys implement `ZeroizeOnDrop`

use crate::{
    CryptoError, CryptoResult,
    AES_KEY_SIZE, ED25519_PUBLIC_KEY_SIZE, ED25519_SECRET_KEY_SIZE,
    X25519_PUBLIC_KEY_SIZE, X25519_SECRET_KEY_SIZE,
    KYBER_PUBLIC_KEY_SIZE, KYBER_SECRET_KEY_SIZE, KYBER_SHARED_SECRET_SIZE,
};
use ed25519_dalek::{Signer, Verifier};
use hkdf::Hkdf;
use sha2::Sha256;
use zeroize::{Zeroize, ZeroizeOnDrop};

/// Ed25519 identity keypair for device authentication
///
/// This is the long-term identity of the device, used for:
/// - Signing device certificates
/// - Authenticating in X3DH handshake
/// - Verifying device identity during pairing
#[derive(Clone)]
pub struct Ed25519Identity {
    /// Public key (32 bytes)
    pub public_key: [u8; ED25519_PUBLIC_KEY_SIZE],
    /// Secret key (32 bytes, zeroized on drop)
    secret_key: [u8; ED25519_SECRET_KEY_SIZE],
}

impl Ed25519Identity {
    /// Generate a new Ed25519 identity keypair
    ///
    /// # Errors
    ///
    /// Returns `CryptoError::RngFailed` if random generation fails.
    pub fn generate() -> CryptoResult<Self> {
        use rand::rngs::OsRng;

        let signing_key = ed25519_dalek::SigningKey::generate(&mut OsRng);
        let verifying_key = signing_key.verifying_key();

        Ok(Self {
            public_key: verifying_key.to_bytes(),
            secret_key: signing_key.to_bytes(),
        })
    }

    /// Create identity from existing keypair bytes
    ///
    /// # Errors
    ///
    /// Returns `CryptoError::InvalidSecretKey` if the secret key is invalid.
    pub fn from_bytes(public_key: &[u8; 32], secret_key: &[u8; 32]) -> CryptoResult<Self> {
        // Validate the keypair by attempting to sign and verify
        let _ = ed25519_dalek::SigningKey::from_bytes(secret_key);

        Ok(Self {
            public_key: *public_key,
            secret_key: *secret_key,
        })
    }

    /// Sign a message using the identity key
    ///
    /// Returns the 64-byte Ed25519 signature.
    pub fn sign(&self, message: &[u8]) -> [u8; 64] {
        let signing_key = ed25519_dalek::SigningKey::from_bytes(&self.secret_key);
        let signature = signing_key.sign(message);
        signature.to_bytes()
    }

    /// Verify a signature using the public key
    ///
    /// Returns true if the signature is valid.
    pub fn verify(&self, message: &[u8], signature: &[u8; 64]) -> bool {
        let verifying_key = match ed25519_dalek::VerifyingKey::from_bytes(&self.public_key) {
            Ok(key) => key,
            Err(_) => return false,
        };

        let signature = match ed25519_dalek::Signature::from_bytes(signature) {
            Ok(sig) => sig,
            Err(_) => return false,
        };

        verifying_key.verify(message, &signature).is_ok()
    }

    /// Get the public key
    pub fn public_key(&self) -> &[u8; 32] {
        &self.public_key
    }

    /// Get the key fingerprint (SHA3-256 of public key, truncated to 16 bytes)
    pub fn fingerprint(&self) -> [u8; 16] {
        let hash = crate::sha3_256_hash(&self.public_key);
        let mut fingerprint = [0u8; 16];
        fingerprint.copy_from_slice(&hash[..16]);
        fingerprint
    }

    /// Get the key fingerprint as a hex string
    pub fn fingerprint_hex(&self) -> String {
        hex::encode(self.fingerprint())
    }
}

impl Zeroize for Ed25519Identity {
    fn zeroize(&mut self) {
        self.public_key.zeroize();
        self.secret_key.zeroize();
    }
}

impl ZeroizeOnDrop for Ed25519Identity {}

/// X25519 keypair for Diffie-Hellman key exchange
///
/// Used in X3DH for ephemeral key exchange with forward secrecy.
#[derive(Clone)]
pub struct X25519Keypair {
    /// Public key (32 bytes)
    pub public_key: [u8; X25519_PUBLIC_KEY_SIZE],
    /// Secret key (32 bytes, zeroized on drop)
    secret_key: [u8; X25519_SECRET_KEY_SIZE],
}

impl X25519Keypair {
    /// Generate a new X25519 keypair
    ///
    /// # Errors
    ///
    /// Returns `CryptoError::RngFailed` if random generation fails.
    pub fn generate() -> CryptoResult<Self> {
        use rand::rngs::OsRng;
        use x25519_dalek::{PublicKey, StaticSecret};

        let secret = StaticSecret::random_from_rng(OsRng);
        let public = PublicKey::from(&secret);

        Ok(Self {
            public_key: public.to_bytes(),
            secret_key: secret.to_bytes(),
        })
    }

    /// Create from existing keypair bytes
    pub fn from_bytes(public_key: &[u8; 32], secret_key: &[u8; 32]) -> Self {
        Self {
            public_key: *public_key,
            secret_key: *secret_key,
        }
    }

    /// Perform Diffie-Hellman key exchange
    ///
    /// Returns the 32-byte shared secret.
    pub fn diffie_hellman(&self, other_public: &[u8; 32]) -> CryptoResult<[u8; 32]> {
        use x25519_dalek::{PublicKey, StaticSecret};

        let secret = StaticSecret::from(self.secret_key);
        let public = PublicKey::from(*other_public);
        let shared = secret.diffie_hellman(&public);

        Ok(shared.to_bytes())
    }

    /// Get the public key
    pub fn public_key(&self) -> &[u8; 32] {
        &self.public_key
    }
}

impl Zeroize for X25519Keypair {
    fn zeroize(&mut self) {
        self.public_key.zeroize();
        self.secret_key.zeroize();
    }
}

impl ZeroizeOnDrop for X25519Keypair {}

/// Kyber-768 post-quantum keypair
///
/// Provides quantum-resistant key encapsulation for hybrid encryption.
#[derive(Clone)]
pub struct Kyber768Keypair {
    /// Public key (1184 bytes)
    pub public_key: [u8; KYBER_PUBLIC_KEY_SIZE],
    /// Secret key (2400 bytes, zeroized on drop)
    secret_key: [u8; KYBER_SECRET_KEY_SIZE],
}

impl Kyber768Keypair {
    /// Generate a new Kyber-768 keypair
    ///
    /// # Errors
    ///
    /// Returns `CryptoError::RngFailed` if random generation fails.
    pub fn generate() -> CryptoResult<Self> {
        let (public_key, secret_key) = pqc_kyber::keypair(&mut rand::thread_rng())
            .map_err(|_| CryptoError::RngFailed)?;

        let mut pk = [0u8; KYBER_PUBLIC_KEY_SIZE];
        let mut sk = [0u8; KYBER_SECRET_KEY_SIZE];
        pk.copy_from_slice(&public_key);
        sk.copy_from_slice(&secret_key);

        Ok(Self {
            public_key: pk,
            secret_key: sk,
        })
    }

    /// Create from existing keypair bytes
    pub fn from_bytes(public_key: &[u8; 1184], secret_key: &[u8; 2400]) -> Self {
        Self {
            public_key: *public_key,
            secret_key: *secret_key,
        }
    }

    /// Encapsulate a shared secret (for sender)
    ///
    /// Returns (ciphertext, shared_secret).
    pub fn encapsulate(&self) -> CryptoResult<(Vec<u8>, [u8; 32])> {
        let (ciphertext, shared_secret) = pqc_kyber::encapsulate(&self.public_key, &mut rand::thread_rng())
            .map_err(|_| CryptoError::KeyExchangeFailed("Kyber encapsulation failed".to_string()))?;

        let mut ss = [0u8; 32];
        ss.copy_from_slice(&shared_secret);

        Ok((ciphertext, ss))
    }

    /// Decapsulate a shared secret (for receiver)
    ///
    /// Returns the 32-byte shared secret.
    pub fn decapsulate(&self, ciphertext: &[u8]) -> CryptoResult<[u8; 32]> {
        let shared_secret = pqc_kyber::decapsulate(ciphertext, &self.secret_key)
            .map_err(|_| CryptoError::KeyExchangeFailed("Kyber decapsulation failed".to_string()))?;

        let mut ss = [0u8; 32];
        ss.copy_from_slice(&shared_secret);

        Ok(ss)
    }

    /// Get the public key
    pub fn public_key(&self) -> &[u8; 1184] {
        &self.public_key
    }
}

impl Zeroize for Kyber768Keypair {
    fn zeroize(&mut self) {
        self.public_key.zeroize();
        self.secret_key.zeroize();
    }
}

impl ZeroizeOnDrop for Kyber768Keypair {}

/// Symmetric key for AES-256-GCM or ChaCha20-Poly1305
///
/// This is a 32-byte key that is securely zeroized when dropped.
#[derive(Clone)]
pub struct SymmetricKey([u8; AES_KEY_SIZE]);

impl SymmetricKey {
    /// Create a new symmetric key from bytes
    ///
    /// # Errors
    ///
    /// Returns `CryptoError::InvalidKeySize` if the input is not 32 bytes.
    pub fn new(bytes: &[u8]) -> CryptoResult<Self> {
        if bytes.len() != AES_KEY_SIZE {
            return Err(CryptoError::InvalidKeySize {
                expected: AES_KEY_SIZE,
                actual: bytes.len(),
            });
        }
        let mut key = [0u8; AES_KEY_SIZE];
        key.copy_from_slice(bytes);
        Ok(Self(key))
    }

    /// Generate a random symmetric key
    ///
    /// # Errors
    ///
    /// Returns `CryptoError::RngFailed` if random generation fails.
    pub fn generate() -> CryptoResult<Self> {
        let key = crate::generate_random_key()?;
        Ok(Self(key))
    }

    /// Get the key bytes
    pub fn as_bytes(&self) -> &[u8; AES_KEY_SIZE] {
        &self.0
    }

    /// Convert to raw bytes (for use with symmetric encryption functions)
    pub fn into_bytes(self) -> [u8; AES_KEY_SIZE] {
        self.0
    }
}

impl Zeroize for SymmetricKey {
    fn zeroize(&mut self) {
        self.0.zeroize();
    }
}

impl ZeroizeOnDrop for SymmetricKey {}

/// Key derivation using HKDF-SHA256
///
/// Derives one or more keys from input keying material (IKM).
///
/// # Arguments
///
/// * `ikm` - Input keying material (the shared secret or master seed)
/// * `salt` - Optional salt value (should be random or fixed per application)
/// * `info` - Context/application-specific information
/// * `length` - Number of bytes to derive
///
/// # Returns
///
/// Returns the derived key material.
///
/// # Example
///
/// ```rust
/// use truffle_crypto::keys::hkdf_derive;
///
/// let ikm = b"input key material";
/// let salt = b"salt value";
/// let info = b"application info";
///
/// let derived = hkdf_derive(ikm, Some(salt), info, 32).unwrap();
/// assert_eq!(derived.len(), 32);
/// ```
pub fn hkdf_derive(
    ikm: &[u8],
    salt: Option<&[u8]>,
    info: &[u8],
    length: usize,
) -> CryptoResult<Vec<u8>> {
    let hkdf = Hkdf::<Sha256>::new(salt, ikm);
    let mut okm = vec![0u8; length];

    hkdf.expand(info, &mut okm)
        .map_err(|e| CryptoError::KeyDerivationFailed(format!("HKDF expansion failed: {:?}", e)))?;

    Ok(okm)
}

/// Derive a 32-byte sync key from a shared secret
///
/// This is used to derive the CRDT encryption key from an X3DH shared secret.
///
/// # Arguments
///
/// * `shared_secret` - The shared secret from X3DH handshake
///
/// # Returns
///
/// Returns a 32-byte key suitable for AES-256-GCM or ChaCha20-Poly1305.
pub fn derive_sync_key(shared_secret: &[u8]) -> CryptoResult<[u8; 32]> {
    let derived = hkdf_derive(
        shared_secret,
        Some(b"truffle-crypto-v1"),
        b"sync-key-derivation",
        32,
    )?;

    let mut key = [0u8; 32];
    key.copy_from_slice(&derived);
    Ok(key)
}

/// Derive multiple keys from a master seed
///
/// This creates the complete key hierarchy for a device.
///
/// # Arguments
///
/// * `master_seed` - 32-byte master seed (must be kept secure!)
///
/// # Returns
///
/// Returns a tuple of (ed25519_identity, x25519_identity, sync_key, kyber_keypair).
pub fn derive_key_hierarchy(
    master_seed: &[u8; 32],
) -> CryptoResult<(Ed25519Identity, X25519Keypair, SymmetricKey, Kyber768Keypair)> {
    // Derive Ed25519 identity key
    let ed25519_seed = hkdf_derive(master_seed, None, b"ed25519-identity", 32)?;
    let ed25519_secret = ed25519_dalek::SigningKey::from_bytes(
        &ed25519_seed.try_into().unwrap()
    );
    let ed25519_public = ed25519_secret.verifying_key();
    let ed25519_identity = Ed25519Identity::from_bytes(
        &ed25519_public.to_bytes(),
        &ed25519_secret.to_bytes(),
    )?;

    // Derive X25519 identity key
    let x25519_seed = hkdf_derive(master_seed, None, b"x25519-identity", 32)?;
    let x25519_secret = x25519_dalek::StaticSecret::from(
        x25519_seed.try_into().unwrap()
    );
    let x25519_public = x25519_dalek::PublicKey::from(&x25519_secret);
    let x25519_identity = X25519Keypair::from_bytes(
        &x25519_public.to_bytes(),
        &x25519_secret.to_bytes(),
    );

    // Derive sync key
    let sync_key_bytes = hkdf_derive(master_seed, None, b"sync-encryption", 32)?;
    let sync_key = SymmetricKey::new(&sync_key_bytes)?;

    // For Kyber, we generate fresh (can't deterministically derive)
    // In production, this could be stored encrypted with the sync key
    let kyber_keypair = Kyber768Keypair::generate()?;

    Ok((ed25519_identity, x25519_identity, sync_key, kyber_keypair))
}

/// Key manager for secure key storage and operations
///
/// This is a high-level interface for managing all cryptographic keys.
/// In production, this would integrate with platform key stores (Secure Enclave, TPM, etc.)
pub struct KeyManager {
    /// Ed25519 identity for device authentication
    ed25519_identity: Ed25519Identity,
    /// X25519 identity for X3DH
    x25519_identity: X25519Keypair,
    /// Symmetric key for sync encryption
    sync_key: SymmetricKey,
    /// Kyber-768 keypair for post-quantum hybrid
    kyber_keypair: Kyber768Keypair,
}

impl KeyManager {
    /// Create a new key manager with randomly generated keys
    ///
    /// # Errors
    ///
    /// Returns `CryptoError::RngFailed` if key generation fails.
    pub fn generate() -> CryptoResult<Self> {
        let ed25519_identity = Ed25519Identity::generate()?;
        let x25519_identity = X25519Keypair::generate()?;
        let sync_key = SymmetricKey::generate()?;
        let kyber_keypair = Kyber768Keypair::generate()?;

        Ok(Self {
            ed25519_identity,
            x25519_identity,
            sync_key,
            kyber_keypair,
        })
    }

    /// Create a key manager from a master seed
    ///
    /// This allows deterministic key derivation from a user-provided seed
    /// (e.g., from a recovery phrase or password).
    ///
    /// # Errors
    ///
    /// Returns `CryptoError::KeyDerivationFailed` if derivation fails.
    pub fn from_master_seed(master_seed: &[u8; 32]) -> CryptoResult<Self> {
        let (ed25519_identity, x25519_identity, sync_key, kyber_keypair) =
            derive_key_hierarchy(master_seed)?;

        Ok(Self {
            ed25519_identity,
            x25519_identity,
            sync_key,
            kyber_keypair,
        })
    }

    /// Get the Ed25519 identity
    pub fn ed25519_identity(&self) -> &Ed25519Identity {
        &self.ed25519_identity
    }

    /// Get the X25519 identity
    pub fn x25519_identity(&self) -> &X25519Keypair {
        &self.x25519_identity
    }

    /// Get the sync key
    pub fn sync_key(&self) -> &SymmetricKey {
        &self.sync_key
    }

    /// Get the Kyber-768 keypair
    pub fn kyber_keypair(&self) -> &Kyber768Keypair {
        &self.kyber_keypair
    }

    /// Generate a new ephemeral X25519 keypair for X3DH
    ///
    /// This should be used once per handshake for forward secrecy.
    pub fn generate_ephemeral_x25519(&self) -> CryptoResult<X25519Keypair> {
        X25519Keypair::generate()
    }

    /// Sign data with the Ed25519 identity key
    pub fn sign(&self, data: &[u8]) -> [u8; 64] {
        self.ed25519_identity.sign(data)
    }

    /// Verify a signature with the Ed25519 identity key
    pub fn verify(&self, data: &[u8], signature: &[u8; 64]) -> bool {
        self.ed25519_identity.verify(data, signature)
    }

    /// Get device fingerprint for pairing verification
    pub fn device_fingerprint(&self) -> String {
        self.ed25519_identity.fingerprint_hex()
    }
}

impl Zeroize for KeyManager {
    fn zeroize(&mut self) {
        self.ed25519_identity.zeroize();
        self.x25519_identity.zeroize();
        self.sync_key.zeroize();
        self.kyber_keypair.zeroize();
    }
}

impl ZeroizeOnDrop for KeyManager {}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_ed25519_identity() {
        let identity = Ed25519Identity::generate().unwrap();
        let message = b"test message";

        let signature = identity.sign(message);
        assert!(identity.verify(message, &signature));

        // Wrong message should fail
        assert!(!identity.verify(b"wrong message", &signature));

        // Wrong signature should fail
        let mut wrong_sig = signature;
        wrong_sig[0] ^= 0xFF;
        assert!(!identity.verify(message, &wrong_sig));
    }

    #[test]
    fn test_x25519_key_exchange() {
        let alice = X25519Keypair::generate().unwrap();
        let bob = X25519Keypair::generate().unwrap();

        let alice_shared = alice.diffie_hellman(&bob.public_key).unwrap();
        let bob_shared = bob.diffie_hellman(&alice.public_key).unwrap();

        assert_eq!(alice_shared, bob_shared);
    }

    #[test]
    fn test_hkdf_derive() {
        let ikm = b"input key material";
        let salt = b"salt value";
        let info = b"application info";

        let derived1 = hkdf_derive(ikm, Some(salt), info, 32).unwrap();
        let derived2 = hkdf_derive(ikm, Some(salt), info, 32).unwrap();

        // Same input should produce same output
        assert_eq!(derived1, derived2);

        // Different info should produce different output
        let derived3 = hkdf_derive(ikm, Some(salt), b"different info", 32).unwrap();
        assert_ne!(derived1, derived3);
    }

    #[test]
    fn test_derive_sync_key() {
        let shared_secret = b"shared secret from x3dh";
        let key1 = derive_sync_key(shared_secret).unwrap();
        let key2 = derive_sync_key(shared_secret).unwrap();

        assert_eq!(key1, key2);
        assert_eq!(key1.len(), 32);
    }

    #[test]
    fn test_key_hierarchy() {
        let master_seed = [0x42u8; 32];
        let (ed1, x1, s1, k1) = derive_key_hierarchy(&master_seed).unwrap();
        let (ed2, x2, s2, k2) = derive_key_hierarchy(&master_seed).unwrap();

        // Same seed should produce same keys (except Kyber which is random)
        assert_eq!(ed1.public_key, ed2.public_key);
        assert_eq!(x1.public_key, x2.public_key);
        assert_eq!(s1.as_bytes(), s2.as_bytes());
    }

    #[test]
    fn test_key_manager() {
        let manager = KeyManager::generate().unwrap();
        let message = b"test message";

        let signature = manager.sign(message);
        assert!(manager.verify(message, &signature));

        // Fingerprint should be valid hex
        let fingerprint = manager.device_fingerprint();
        assert_eq!(fingerprint.len(), 32); // 16 bytes = 32 hex chars
    }

    #[test]
    fn test_symmetric_key() {
        let key1 = SymmetricKey::generate().unwrap();
        let key2 = SymmetricKey::generate().unwrap();

        // Two random keys should be different
        assert_ne!(key1.as_bytes(), key2.as_bytes());

        // Key should be 32 bytes
        assert_eq!(key1.as_bytes().len(), 32);
    }

    #[test]
    fn test_kyber_encapsulation() {
        let keypair = Kyber768Keypair::generate().unwrap();

        let (ciphertext, shared_secret1) = keypair.encapsulate().unwrap();
        let shared_secret2 = keypair.decapsulate(&ciphertext).unwrap();

        assert_eq!(shared_secret1, shared_secret2);
    }

    #[test]
    fn test_key_zeroize() {
        let mut key = SymmetricKey::generate().unwrap();
        let bytes_before = *key.as_bytes();
        assert_ne!(bytes_before, [0u8; 32]);

        key.zeroize();
        assert_eq!(key.as_bytes(), &[0u8; 32]);
    }
}
