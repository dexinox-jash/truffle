<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    TruffleShareExtension.entitlements
    Share extension entitlements for Project Truffle
-->
<plist version="1.0">
<dict>
    <!-- App Groups - Required for communication with main app -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.truffle.shared</string>
    </array>
    
    <!-- Keychain Sharing -->
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)com.truffle.shared</string>
    </array>
    
    <!-- Extension-specific settings -->
    <key>com.apple.security.get-task-allow</key>
    <false/>
</dict>
</plist>
