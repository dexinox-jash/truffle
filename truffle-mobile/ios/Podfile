# Truffle iOS - CocoaPods Dependencies
# SPEC v2.0 Section 5.3: Mobile Companion
#
# Dependencies:
# - SQLite.swift: Local database for wiki and raw storage
# - Yams: YAML parsing for schema files
# - BackgroundTasks: Background processing (Apple framework)
# - CryptoKit: Encryption (Apple framework)

platform :ios, '15.0'
use_frameworks!

# Disable warnings for pods
inhibit_all_warnings!

# Main App Target
target 'TruffleApp' do
  # Database
  pod 'SQLite.swift', '~> 0.14.0'
  
  # YAML parsing for schema files
  pod 'Yams', '~> 5.0.0'
  
  # Markdown rendering
  pod 'MarkdownUI', '~> 2.0.0'
  
  # Image loading and caching
  pod 'SDWebImageSwiftUI', '~> 2.0.0'
  
  # Network
  pod 'Alamofire', '~> 5.8.0'
  
  # Keychain wrapper (optional - we use native Security framework)
  # pod 'KeychainAccess', '~> 4.2.0'
  
  target 'TruffleAppTests' do
    inherit! :search_paths
    pod 'Quick', '~> 7.0.0'
    pod 'Nimble', '~> 13.0.0'
  end
  
  target 'TruffleAppUITests' do
    inherit! :search_paths
  end
end

# Share Extension Target
target 'TruffleShareExtension' do
  # Database (shared with main app)
  pod 'SQLite.swift', '~> 0.14.0'
  
  # Minimal dependencies for extension
  # Extensions have strict memory limits
end

# TruffleCore Framework (shared between app and extension)
target 'TruffleCore' do
  # Database
  pod 'SQLite.swift', '~> 0.14.0'
  
  # YAML parsing
  pod 'Yams', '~> 5.0.0'
  
  # Network
  pod 'Alamofire', '~> 5.8.0'
end

# Post-install configuration
post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      # Set iOS deployment target
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      
      # Enable Swift 5.9
      config.build_settings['SWIFT_VERSION'] = '5.9'
      
      # Disable bitcode (deprecated in Xcode 14)
      config.build_settings['ENABLE_BITCODE'] = 'NO'
      
      # Code signing settings
      config.build_settings['CODE_SIGNING_REQUIRED'] = 'YES'
      config.build_settings['CODE_SIGNING_ALLOWED'] = 'YES'
      
      # App Groups for extension communication
      config.build_settings['APPLICATION_EXTENSION_API_ONLY'] = 'NO'
      
      # Optimization settings
      if config.name == 'Release'
        config.build_settings['SWIFT_OPTIMIZATION_LEVEL'] = '-O'
        config.build_settings['SWIFT_COMPILATION_MODE'] = 'wholemodule'
      else
        config.build_settings['SWIFT_OPTIMIZATION_LEVEL'] = '-Onone'
      end
      
      # Extension-specific settings
      if target.name == 'TruffleShareExtension'
        config.build_settings['APPLICATION_EXTENSION_API_ONLY'] = 'YES'
        config.build_settings['OTHER_SWIFT_FLAGS'] = '-DEXTENSION'
      end
    end
  end
  
  # Configure app groups
  installer.aggregate_targets.each do |target|
    target.user_project.targets.each do |user_target|
      user_target.build_configurations.each do |config|
        config.build_settings['CODE_SIGN_ENTITLEMENTS'] = "${TARGET_NAME}/${TARGET_NAME}.entitlements"
      end
    end
  end
end
