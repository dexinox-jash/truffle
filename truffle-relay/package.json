{
  "name": "@truffle/relay",
  "version": "1.0.0",
  "description": "Project Truffle Zero-Knowledge Relay Server - Cloudflare Workers",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "cf-typegen": "wrangler types"
  },
  "keywords": [
    "truffle",
    "zero-knowledge",
    "relay",
    "cloudflare-workers",
    "e2ee",
    "privacy"
  ],
  "author": "Project Truffle Engineering",
  "license": "AGPL-3.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "itty-router": "^5.0.18",
    "@tsndr/cloudflare-worker-jwt": "^3.1.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.18",
    "@cloudflare/workers-types": "^4.20241112.0",
    "@types/node": "^20.14.10",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "eslint": "^8.57.0",
    "miniflare": "^3.20241106.1",
    "prettier": "^3.3.3",
    "typescript": "^5.5.3",
    "vitest": "^2.1.5",
    "wrangler": "^3.91.0"
  },
  "packageManager": "pnpm@9.0.0"
}
